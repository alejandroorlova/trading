# ===================================
# CONFIGURACIÓN OPTIMIZADA BASADA EN RESULTADOS
# ===================================

# SERVIDOR
HOST=127.0.0.1
PORT=5000
DEBUG=False

# BASE DE DATOS
DATABASE_URL=sqlite:///simple_trading.db

# METATRADER 5
MT5_LOGIN=XXXX
MT5_PASSWORD=XXXXX
MT5_SERVER=XXXXXX

# ===================================
# CONFIGURACIÓN DE TRADING OPTIMIZADA
# ===================================

# Tamaño de posición
POSITION_SIZE=0.01

# Magic Number
MAGIC_NUMBER=123456

# Slippage máximo
SLIPPAGE=10

# ===================================
# GESTIÓN DE RIESGO MEJORADA
# ===================================

# Ratios de beneficio (basado en análisis, enfocarse en ratios más bajos)
# Los ratios 2-4 tuvieron mejor desempeño
REWARD_RATIOS=10

# Stop Loss Configuration
# AUMENTADO: Más margen desde la vela para evitar cierres prematuros
SL_MARGIN_TICKS=10  # Aumentado de 5 a 10

# AUMENTADO: Distancia mínima del SL
MIN_SL_DISTANCE=30  # Aumentado de 20 a 30

# NUEVO: Buffer de protección contra spread
SPREAD_BUFFER_TICKS=15  # Buffer adicional para proteger contra spread
MAX_SPREAD_ALLOWED=500   # No operar si spread > 30 ticks

# NUEVO: Protección de entrada
ENTRY_BUFFER_TICKS=5     # Esperar mejor precio de entrada
WAIT_FOR_BETTER_PRICE=False  # Activar si quieres esperar mejor precio

# NUEVO: Control de riesgo
MIN_RISK_REWARD_RATIO=1.5  # No entrar si ratio < 1.5
SKIP_HIGH_SPREAD=True      # Saltar operaciones con spread alto

# ===================================
# CONFIGURACIÓN DE TIEMPO
# ===================================

# Modo de ejecución
EXECUTION_MODE=NEXT_MINUTE  # Ejecutar al cambio de minuto

# Intervalo de verificación de precios
PRICE_CHECK_INTERVAL=1

# Horario de trading (opcional)
TRADING_START_HOUR=0
TRADING_END_HOUR=24